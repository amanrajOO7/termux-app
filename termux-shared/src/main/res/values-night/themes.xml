<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
     https://material.io/develop/android/theming/dark
    -->

    <!--
     BaseActivity DayNight DarkActionBar theme.
     Material 3 has no DarkActionBar variant, the app bar uses the surface color instead. The Expressive themes require Material Components 1.14.0 or higher.
     https://github.com/material-components/material-components-android/blob/1.14.0/lib/java/com/google/android/material/theme/res/values/themes.xml
    -->
    <style name="Theme.BaseActivity.DayNight.DarkActionBar" parent="Theme.Material3Expressive.Dark">
        <!-- Text color. -->
        <item name="android:textColorLink">@color/blue_link_dark</item>

        <!-- Dialog Themes, see the comment in the day themes. -->
        <item name="alertDialogTheme">@style/ThemeOverlay.BaseDialog.DayNight</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BaseDialog.DayNight</item>
    </style>

    <!-- BaseActivity DayNight NoActionBar theme. -->
    <style name="Theme.BaseActivity.DayNight.NoActionBar" parent="Theme.BaseActivity.DayNight.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>





    <!--
      BaseDialog DayNight theme.
      https://github.com/material-components/material-components-android/blob/1.14.0/lib/java/com/google/android/material/dialog/res/values/themes.xml
     -->
    <style name="ThemeOverlay.BaseDialog.DayNight" parent="ThemeOverlay.Material3.MaterialAlertDialog"/>

</resources>
