<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:icon="@drawable/ic_preference_bug"
        app:title="@string/termux_debugging_preferences_title"
        app:summary="@string/termux_debugging_preferences_summary"
        app:fragment="com.termux.app.fragments.settings.termux.DebuggingPreferencesFragment"/>

    <Preference
        app:icon="@drawable/ic_preference_keyboard"
        app:title="@string/termux_terminal_io_preferences_title"
        app:summary="@string/termux_terminal_io_preferences_summary"
        app:fragment="com.termux.app.fragments.settings.termux.TerminalIOPreferencesFragment"/>

    <Preference
        app:icon="@drawable/ic_preference_text_size"
        app:title="@string/termux_terminal_view_preferences_title"
        app:summary="@string/termux_terminal_view_preferences_summary"
        app:fragment="com.termux.app.fragments.settings.termux.TerminalViewPreferencesFragment"/>

    <SwitchPreferenceCompat
        app:key="show_session_tabs"
        app:icon="@drawable/ic_preference_terminal"
        app:title="@string/termux_show_session_tabs_title"
        app:summaryOff="@string/termux_show_session_tabs_summary_off"
        app:summaryOn="@string/termux_show_session_tabs_summary_on" />

    <Preference
        app:key="extra_keys_editor"
        app:icon="@drawable/ic_preference_keyboard"
        app:title="@string/extra_keys_editor_title"
        app:summary="@string/extra_keys_editor_summary"
        app:persistent="false"/>

    <Preference
        app:key="style_color_scheme"
        app:icon="@drawable/ic_preference_terminal"
        app:title="@string/style_color_scheme_title"
        app:summary="@string/style_color_scheme_summary"
        app:persistent="false"/>

    <Preference
        app:key="style_font"
        app:icon="@drawable/ic_preference_text_size"
        app:title="@string/style_font_title"
        app:summary="@string/style_font_summary"
        app:persistent="false"/>

</PreferenceScreen>
