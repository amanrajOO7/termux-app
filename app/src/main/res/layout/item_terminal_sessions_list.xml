<?xml version="1.0" encoding="utf-8"?>
<!--
  Outer frame is the ListView item root (it receives the activated/checked state);
  the inner row duplicates that state so the rounded selected background and ripple
  can be inset from the drawer edges.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="2dp">

    <LinearLayout
        android:id="@+id/session_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/termuxSessionItemBackground"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <View
            android:id="@+id/session_status"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/session_status_dot"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/session_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/termuxSessionItemTitleColor"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/session_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/termuxSessionItemSubtitleColor"
                android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/session_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close_tab"
            android:focusable="false"
            android:padding="9dp"
            android:src="@drawable/ic_tab_close"
            app:tint="?attr/termuxSessionItemSubtitleColor" />
    </LinearLayout>
</FrameLayout>
